{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd backend && ./venv/bin/python -m uvicorn app.main:app --reload --port 8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port 5173"],
      "port": 5173
    }
  ]
}
